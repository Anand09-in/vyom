# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Secrets — NEVER commit .env
.env

# Data (raw PDFs and CSVs belong in S3, not git)
data/
*.sqlite
mlruns/

# Eval run artifacts — churn every run, not source of truth
eval/results*.json

# OS / editor
.DS_Store
.idea/
.vscode/

# Terraform state and plan files (both can contain secrets in plaintext,
# e.g. the RDS password — plan files redact sensitive values from CLI
# output only, not from the file itself)
infra/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.tfplan
infra/lambda/*.zip

# Structured request logs — real user ids/queries, not source of truth
logs/

# Node
node_modules/
.next/