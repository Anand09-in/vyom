# ── Provider ──────────────────────────────────────────────────────────────────
# local  = BGE-M3 + Ollama  (free, runs on your machine — use this for dev)
# bedrock = Amazon Bedrock  (used only in AWS deployment)
VYOM_PROVIDER=local

# ── Database ───────────────────────────────────────────────────────────────────
VYOM_DATABASE_URL=postgresql://vyom:vyom@localhost:5432/vyom
VYOM_DB_POOL_MIN=2
VYOM_DB_POOL_MAX=10
VYOM_EMBEDDING_DIM=1024

# ── Local provider ─────────────────────────────────────────────────────────────
VYOM_LOCAL_EMBED_MODEL=BAAI/bge-m3
VYOM_LOCAL_RERANK_MODEL=BAAI/bge-reranker-v2-m3
VYOM_OLLAMA_HOST=http://localhost:11434
VYOM_OLLAMA_MODEL=qwen2.5:7b

# ── Bedrock provider (fill in during Phase 4 AWS deploy) ──────────────────────
VYOM_AWS_REGION=ap-south-1
VYOM_BEDROCK_EMBED_MODEL=amazon.titan-embed-text-v2:0
VYOM_BEDROCK_GEN_MODEL=anthropic.claude-3-5-sonnet-20241022-v2:0
VYOM_BEDROCK_RERANK_MODEL=amazon.rerank-v1:0

# ── Data sources (all free, no keys needed) ────────────────────────────────────
VYOM_BSE_DOWNLOAD_FOLDER=./data/bse
VYOM_S3_BUCKET=vyom-raw-data

# ── Retrieval ──────────────────────────────────────────────────────────────────
VYOM_TOP_K=20
VYOM_RERANK_TOP_N=5
VYOM_MAX_REWRITE_LOOPS=2

# ── API ────────────────────────────────────────────────────────────────────────
VYOM_CORS_ORIGINS=http://localhost:3000
VYOM_RATE_LIMIT=30/minute

# ── Enabled sources ────────────────────────────────────────────────────────────
# Comma-separated. Controls which stores the router considers.
VYOM_ENABLED_SOURCES=bse,sebi,rbi,cross
