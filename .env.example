# ── Provider ──────────────────────────────────────────────────────────────────
# local   = generation via Ollama (free, runs on your machine — good for dev)
# bedrock = generation via Amazon Bedrock (Ollama models too small for
#           production quality). Embedding + reranking ALWAYS run locally
#           regardless of this setting — see providers/bedrock.py.
VYOM_PROVIDER=local

# ── Database ───────────────────────────────────────────────────────────────────
VYOM_DATABASE_URL=postgresql://vyom:vyom@localhost:5432/vyom
VYOM_DB_POOL_MIN=2
VYOM_DB_POOL_MAX=10
VYOM_EMBEDDING_DIM=512

# ── Conversation history (Redis) ─────────────────────────────────────────────
VYOM_REDIS_URL=redis://localhost:6379/0

# ── Local provider ─────────────────────────────────────────────────────────────
# nomic-embed-text-v1.5: English, 137M params, 8192-token context, higher
# MTEB retrieval score than MiniLM or Bedrock Titan v2 on English text.
# Truncated to VYOM_EMBEDDING_DIM (512, a more "standard" embedding size)
# via native Matryoshka support — native max is 768. Requires
# trust_remote_code and asymmetric "search_document:"/"search_query:"
# prefixes — handled in LocalProvider.
VYOM_LOCAL_EMBED_MODEL=nomic-ai/nomic-embed-text-v1.5
VYOM_LOCAL_RERANK_MODEL=BAAI/bge-reranker-v2-m3
VYOM_OLLAMA_HOST=http://localhost:11434
VYOM_OLLAMA_MODEL=qwen2.5:3b

# ── Bedrock provider ────────────────────────────────────────────────────────────
VYOM_AWS_REGION=ap-south-1
# Used only by the RAGAS judge's answer_relevancy metric — not by
# BedrockProvider, which always embeds locally regardless of VYOM_PROVIDER.
VYOM_BEDROCK_EMBED_MODEL=amazon.titan-embed-text-v2:0
# Mistral Large 3, not Claude — Anthropic models typically need an AWS
# Marketplace subscription with a valid payment instrument set up
# separately. Deliberately a different model family from
# VYOM_RAGAS_JUDGE_BEDROCK_MODEL (DeepSeek) so the judge isn't scoring its
# own model family's output. Works on-demand, no inference profile needed.
VYOM_BEDROCK_GEN_MODEL=mistral.mistral-large-3-675b-instruct
# Prompt-injection / off-topic defense — infra/main.tf's aws_bedrock_guardrail.vyom.
# Run `terraform output` in infra/ after `terraform apply` to get real values.
VYOM_BEDROCK_GUARDRAIL_ID=
VYOM_BEDROCK_GUARDRAIL_VERSION=1

# ── Auth (Cognito) ────────────────────────────────────────────────────────────
# From infra/main.tf outputs after `terraform apply` — every route except
# /health requires a valid Cognito JWT, see api/deps.py's get_current_user.
VYOM_COGNITO_USER_POOL_ID=
VYOM_COGNITO_APP_CLIENT_ID=
VYOM_COGNITO_ISSUER_URL=

# ── Data sources ────────────────────────────────────────────────────────────
VYOM_BSE_DOWNLOAD_FOLDER=./data/bse
VYOM_S3_BUCKET=vyom-raw-data
# Live web search (current prices, same-day news) — get a free key at
# app.tavily.com. Blank = the "live" source silently contributes nothing.
VYOM_TAVILY_API_KEY=

# ── Eval (RAGAS judge) ──────────────────────────────────────────────────────────
# Deliberately a third model family, different from both VYOM_OLLAMA_MODEL
# and VYOM_BEDROCK_GEN_MODEL, so the judge isn't scoring its own model
# family's output. local = Ollama (free, but RAGAS's many concurrent
# structured-output judge calls can overwhelm a CPU-bound local model —
# timeouts are common). bedrock = more reliable, needs AWS credentials
# with Bedrock model access enabled.
VYOM_RAGAS_JUDGE_PROVIDER=local
VYOM_RAGAS_JUDGE_OLLAMA_MODEL=qwen2.5:7b
# Used when ragas_judge_provider=bedrock. DeepSeek V3.2, not Claude —
# Anthropic models need an AWS Marketplace subscription with a valid payment
# instrument set up separately; DeepSeek works on-demand without one, with a
# much higher default quota (100 RPM / 100M TPM) than smaller on-demand models.
VYOM_RAGAS_JUDGE_BEDROCK_MODEL=deepseek.v3.2

# ── Retrieval ──────────────────────────────────────────────────────────────────
VYOM_TOP_K=20
VYOM_RERANK_TOP_N=5
VYOM_MAX_REWRITE_LOOPS=2

# ── API ────────────────────────────────────────────────────────────────────────
VYOM_CORS_ORIGINS=http://localhost:3000
VYOM_RATE_LIMIT=30/minute

# ── Enabled sources ────────────────────────────────────────────────────────────
# Comma-separated. Controls which stores the router considers.
VYOM_ENABLED_SOURCES=bse,sebi,rbi,cross,live
